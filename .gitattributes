# Normalise line endings in the repository; check out with native endings.
* text=auto

# Scripts that must keep specific endings
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.sh   text eol=lf
*.py   text eol=lf
*.sql  text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.css  text eol=lf
*.html text eol=lf
tests/fixtures/**/*.csv text eol=lf

# Binary assets
*.png  binary
*.jpg  binary
*.gif  binary
*.webm binary
*.mp4  binary
*.pdf  binary
*.pptx binary
*.woff binary
*.woff2 binary

# Rendered fixtures reproduce the real ESMI byte layout (CRLF); keep their bytes exactly.
tests/fixtures/rendered/**/*.csv -text
