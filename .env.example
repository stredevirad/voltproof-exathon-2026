# Copy to .env (gitignored) and fill in. Never commit .env.

# --- Exasol Personal (local) ---
# Deployment directory outside the repo; every launcher call uses it via scripts\exa.ps1
EXASOL_DEPLOYMENT_DIR=D:\ExasolDeployments\voltproof
# Connection details are read from <EXASOL_DEPLOYMENT_DIR>\secrets.json at runtime. Do not copy them here.

# --- ESMI data download (Harvard Dataverse) ---
# Each file download requires a Guestbook response (Dataverse guestbook 251).
# Supply YOUR OWN details; they are sent to dataverse.harvard.edu with each download request.
DATAVERSE_GB_NAME=
DATAVERSE_GB_EMAIL=
DATAVERSE_GB_INSTITUTION=
DATAVERSE_GB_POSITION=
DATAVERSE_GB_INTENDED_USE=Non-commercial research and an open-source competition prototype analysing electricity supply interruptions (VoltProof); source acknowledged as Prayas (Energy Group) ESMI.

# --- Project caches (defaults shown; all under the repo's gitignored .cache) ---
# VOLTPROOF_CACHE=D:\Projects\VoltProof\.cache
