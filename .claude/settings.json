{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git show*)",
      "PowerShell(git branch*)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git tag *)",
      "PowerShell(git rev-parse *)",
      "PowerShell(git ls-files*)",
      "PowerShell(git check-ignore *)",
      "PowerShell(git remote -v)",
      "PowerShell(gh auth status*)",
      "PowerShell(gh repo view *)",
      "PowerShell(gh release view *)",
      "PowerShell(gh release list *)",
      "PowerShell(uv run *)",
      "PowerShell(uv sync*)",
      "PowerShell(uv pip *)",
      "PowerShell(uv lock*)",
      "PowerShell(uv venv*)",
      "PowerShell(uv python list*)",
      "PowerShell(npm run *)",
      "PowerShell(npm ci*)",
      "PowerShell(npm install*)",
      "PowerShell(node --version)",
      "PowerShell(.\\scripts\\*)",
      "PowerShell(& .\\scripts\\*)",
      "PowerShell(powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\*)",
      "PowerShell(*exasol* status*)",
      "PowerShell(*exasol* info*)",
      "PowerShell(*exasol* version*)",
      "PowerShell(*exasol* connect *)",
      "PowerShell(*exasol* start*)",
      "PowerShell(*exasol* stop*)",
      "PowerShell(*exasol* diag local*)",
      "PowerShell(*exasol* diag info*)",
      "PowerShell(*exasol* diag cache*)",
      "PowerShell(*exasol* config get*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git tag *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files*)",
      "Bash(git check-ignore *)",
      "Bash(uv run *)",
      "Bash(uv sync*)",
      "Bash(uv pip *)",
      "Bash(npm run *)",
      "Bash(npm ci*)"
    ],
    "ask": [
      "PowerShell(git push*)",
      "PowerShell(git clean *)",
      "PowerShell(git rebase *)",
      "PowerShell(git tag -d *)",
      "PowerShell(winget install *)",
      "PowerShell(winget upgrade *)",
      "PowerShell(winget uninstall *)",
      "PowerShell(wsl --shutdown*)",
      "PowerShell(wsl --terminate *)",
      "PowerShell(podman machine *)",
      "PowerShell(*exasol* install *)",
      "PowerShell(*exasol* init *)",
      "PowerShell(*exasol* deploy*)",
      "PowerShell(*exasol* slc *)",
      "PowerShell(*exasol* config set*)",
      "PowerShell(*exasol* config reset*)",
      "PowerShell(*exasol* diag unlock*)",
      "PowerShell(*exasol* cache clean*)",
      "Bash(git push*)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(*exasol* install *)",
      "Bash(*exasol* slc *)",
      "Bash(*exasol* config set*)"
    ],
    "deny": [
      "PowerShell(*exasol* destroy*)",
      "PowerShell(*exasol* remove*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git remote add *)",
      "PowerShell(git remote remove *)",
      "PowerShell(git remote rm *)",
      "PowerShell(git remote set-url *)",
      "PowerShell(git remote rename *)",
      "PowerShell(git filter-branch *)",
      "PowerShell(gh repo create *)",
      "PowerShell(gh repo delete *)",
      "PowerShell(gh repo rename *)",
      "PowerShell(gh repo edit *)",
      "PowerShell(wsl --unregister *)",
      "PowerShell(wsl --manage *)",
      "PowerShell(podman machine rm*)",
      "PowerShell(podman machine reset*)",
      "PowerShell(podman system reset*)",
      "PowerShell(Remove-Item *C:\\*)",
      "Bash(*exasol* destroy*)",
      "Bash(*exasol* remove*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git remote add *)",
      "Bash(git remote remove *)",
      "Bash(git remote set-url *)",
      "Bash(git filter-branch *)",
      "Bash(gh repo create *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo rename *)",
      "Bash(gh repo edit *)",
      "Bash(wsl --unregister *)",
      "Bash(wsl.exe --unregister *)",
      "Bash(podman machine rm*)",
      "Bash(podman machine reset*)",
      "Bash(podman system reset*)",
      "Bash(rm -rf /c/*)",
      "Bash(rm -rf ~*)",
      "Edit(~/.wslconfig)"
    ]
  }
}
